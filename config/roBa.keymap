/*
 * roBa OSM keymap
 * hold-tap 完全排除、Callum式 One-Shot ベース
 * Charybdis / Corne と同じ設計
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE   0
#define NAV    1
#define SYM    2
#define FUN    3
#define MOUSE  4
#define SCROLL 5

// --- トラックボール設定 ---
&trackball {
    automouse-layer = <MOUSE>;
    scroll-layers = <SCROLL>;
};

// --- One-Shot Modifier 設定 ---
&sk {
    release-after-ms = <2000>;
};

// --- スクロール速度 ---
&msc {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <1>;
};

/ {
    // --- Macros（Charybdis から移植） ---
    macros {
        // Swapper（Cmd+Tab: キーを離すまでCmdを保持）
        mc_swap: mc_swap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp TAB>, <&macro_pause_for_release>, <&macro_release &kp LGUI>;
        };
        // Tabber（Ctrl+Tab: キーを離すまでCtrlを保持）
        mc_tab: mc_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp TAB>, <&macro_pause_for_release>, <&macro_release &kp LCTRL>;
        };
        // Undo (Cmd+Z)
        mc_undo: mc_undo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp Z>, <&macro_release &kp LGUI>;
        };
        // Cut (Cmd+X)
        mc_cut: mc_cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp X>, <&macro_release &kp LGUI>;
        };
        // Copy (Cmd+C)
        mc_copy: mc_copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp C>, <&macro_release &kp LGUI>;
        };
        // Paste (Cmd+V)
        mc_paste: mc_paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp V>, <&macro_release &kp LGUI>;
        };
        // Redo (Cmd+Shift+Z)
        mc_redo: mc_redo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_press &kp LGUI>, <&macro_press &kp LSHFT>, <&macro_tap &kp Z>, <&macro_release &kp LSHFT>, <&macro_release &kp LGUI>;
        };
        // Zoom In (Cmd+=)
        mc_zmin: mc_zmin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp EQUAL>, <&macro_release &kp LGUI>;
        };
        // Zoom Out (Cmd+-)
        mc_zmout: mc_zmout {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp MINUS>, <&macro_release &kp LGUI>;
        };
    };

    // --- Combos ---
    // Key positions:
    // Row 0:  0(Q)  1(W)  2(E)  3(R)  4(T)  |  5(Y)  6(U)  7(I)  8(O)  9(P)
    // Row 1: 10(A) 11(S) 12(D) 13(F) 14(G) 15(×) | 16(×) 17(H) 18(J) 19(K) 20(L) 21(')
    // Row 2: 22(Z) 23(X) 24(C) 25(V) 26(B) 27(×) | 28(×) 29(N) 30(M) 31(,) 32(.) 33(/)
    // Row 3: 34(×) 35(×) 36(×) 37(NAV) 38(SPC) 39(SYM) | 40(BSPC) 41(ENT)  42(×)
    combos {
        compatible = "zmk,combos";

        // SPC(38) + BSPC(40) → LNG1 (IME ON)
        combo_lng1 {
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            key-positions = <38 40>;
            bindings = <&kp LANGUAGE_1>;
            layers = <BASE>;
        };

        // BSPC(40) + ENT(41) → LNG2 (IME OFF)
        combo_lng2 {
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            key-positions = <40 41>;
            bindings = <&kp LANGUAGE_2>;
            layers = <BASE>;
        };
    };

    // --- Conditional Layer (NAV + SYM = FUN) ---
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <FUN>;
        };
    };

    // --- Keymap ---
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: BASE (QWERTY)
        BASE_layer {
            display-name = "Base";
            bindings = <
&kp Q      &kp W      &kp E      &kp R      &kp T                                          &kp Y      &kp U      &kp I      &kp O      &kp P
&kp A      &kp S      &kp D      &kp F      &kp G      &none                  &none         &kp H      &kp J      &kp K      &kp L      &kp SQT
&kp Z      &kp X      &kp C      &kp V      &kp B      &none                  &none         &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH
&none      &none      &none      &mo NAV    &kp SPC    &mo SYM                &kp BSPC      &kp RET                                      &none
            >;
        };

        // Layer 1: NAV（左親指左で有効）- Charybdis と同じ配置
        NAV_layer {
            display-name = "Nav";
            bindings = <
&kp ESC    &mc_swap   &mc_tab    &kp CAPS   &none                                          &kp HOME       &kp PG_DN      &kp PG_UP      &kp END    &mkp LCLK
&sk LCTRL  &sk LSHFT  &sk LALT   &sk LGUI   &kp TAB    &none                  &none        &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT  &mkp RCLK
&mc_undo   &mc_cut    &mc_copy   &mc_paste  &mc_redo   &none                  &none        &msc SCRL_DOWN &msc SCRL_UP   &mc_zmin       &mc_zmout  &mkp MCLK
&none      &none      &none      &trans     &trans     &trans                 &trans       &trans                                                  &none
            >;
        };

        // Layer 2: SYM（左親指右で有効）
        SYM_layer {
            display-name = "Sym";
            bindings = <
&kp N1     &kp N2     &kp N3     &kp N4     &kp N5                                          &kp N6     &kp N7     &kp N8     &kp N9     &kp N0
&sk LCTRL  &sk LSHFT  &sk LALT   &sk LGUI   &none      &none                  &none         &kp EQUAL  &kp BSLH   &kp GRAVE  &kp SEMI   &kp SQT
&none      &none      &none      &none      &none      &none                  &none         &kp LBKT   &kp RBKT   &kp LBRC   &kp RBRC   &kp PIPE
&none      &none      &none      &trans     &trans     &trans                 &trans        &trans                                       &none
            >;
        };

        // Layer 3: FUN（NAV + SYM 同時で自動発動）
        FUN_layer {
            display-name = "Fun";
            bindings = <
&kp F1     &kp F2     &kp F3     &kp F4     &kp F5                                          &none         &none         &none         &none      &none
&kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &none                  &none         &kp K_MUTE    &kp K_VOL_DN  &kp K_VOL_UP  &none      &none
&kp F11    &kp F12    &none      &none      &none      &none                  &none         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR &out OUT_TOG
&none      &none      &none      &trans     &trans     &trans                 &trans        &trans                                                &none
            >;
        };

        // Layer 4: MOUSE（トラックボール動かすと自動発動）
        MOUSE_layer {
            display-name = "Mouse";
            bindings = <
&trans     &trans     &trans     &trans     &trans                                            &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans                 &trans          &trans     &mkp MB1   &mkp MB3   &mkp MB2   &trans
&trans     &trans     &trans     &trans     &trans     &trans                 &trans          &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans                 &trans          &trans                                      &trans
            >;
        };

        // Layer 5: SCROLL（NAV+SCRLで切替、トラックボール→スクロール）
        SCROLL_layer {
            display-name = "Scroll";
            bindings = <
&trans     &trans     &trans     &trans     &trans                                            &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans                 &trans          &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans                 &trans          &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans                 &trans          &trans                                      &trans
            >;
        };
    };
};
